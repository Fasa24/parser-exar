FUNCIÓN runPushdownAutomaton(tokens, num_linea)
    errores ← Lista vacía
    pila ← Pila vacía
    apilar(pila, BOTTOM)
    apilar(pila, EXPR)

    etiqueta_linea ← "Line " + formatearNumeroLinea(num_linea) + ": "
    idx ← 0
    n ← longitud(tokens)
    profundidad_parentesis ← 0
    pasos ← 0
    max_pasos ← MAX(200, n * 30 + 100)

    MIENTRAS (NO pila ESTÁ VACÍA) Y (pasos < max_pasos) HACER
        pasos ← pasos + 1
        cima ← verCima(pila)
        actual ← SI idx < n ENTONCES tokens[idx].tipo SINO NULO

        SI cima == BOTTOM ENTONCES
            SI actual == NULO ENTONCES
                desapilar(pila)
                ROMPER
            FIN SI
            SI actual == RPAREN ENTONCES
                agregar(errores, ("201", etiqueta_linea + "Missing delimiter '(' or extra ')'."))
            SINO
                agregar(errores, ("202", etiqueta_linea + "Missing operator before '" + tokens[idx].lexema + "'."))
            FIN SI
            idx ← idx + 1
            CONTINUAR
        FIN SI

        SI esTerminal(cima) ENTONCES
            SI cima == RPAREN ENTONCES
                SI actual == RPAREN ENTONCES
                    idx ← idx + 1
                SINO
                    agregar(errores, ("201", etiqueta_linea + "Missing delimiter ')'."))
                FIN SI
                desapilar(pila)
                profundidad_parentesis ← MAX(0, profundidad_parentesis - 1)
                CONTINUAR
            FIN SI

            SI actual != NULO Y coincideTerminal(cima, actual) ENTONCES
                SI cima == LPAREN ENTONCES
                    profundidad_parentesis ← profundidad_parentesis + 1
                FIN SI
                desapilar(pila)
                idx ← idx + 1
            SINO
                SI cima == LPAREN ENTONCES
                    agregar(errores, ("201", etiqueta_linea + "Missing delimiter '('."))
                SINO
                    agregar(errores, ("202", etiqueta_linea + "Missing operator."))
                FIN SI
                desapilar(pila)
            FIN SI
            CONTINUAR
        FIN SI

        SEGÚN cima HACER
            CASO EXPR:
                desapilar(pila)
                SI actual == NULO ENTONCES
                    agregar(errores, ("203", etiqueta_linea + "Missing identifier/constant."))
                SINO SI esInicioFactor(actual) ENTONCES
                    apilar(pila, EXPR_TAIL)
                    apilar(pila, TERM)
                SINO SI actual == RPAREN ENTONCES
                    agregar(errores, ("203", etiqueta_linea + "Missing identifier/constant before ')'."))
                SINO SI esOperadorMultiplicativo(actual) ENTONCES
                    agregar(errores, ("203", etiqueta_linea + "Missing identifier/constant before '" + tokens[idx].lexema + "'."))
                    idx ← idx + 1
                    apilar(pila, EXPR)
                SINO
                    agregar(errores, ("203", etiqueta_linea + "Missing identifier/constant near '" + tokens[idx].lexema + "'."))
                    idx ← idx + 1
                    apilar(pila, EXPR)
                FIN SI

            CASO EXPR_TAIL:
                desapilar(pila)
                SI actual EN {PLUS, MINUS} ENTONCES
                    apilar(pila, EXPR_TAIL)
                    apilar(pila, TERM)
                    apilar(pila, SI actual == PLUS ENTONCES PLUS SINO MINUS)
                SINO SI actual == RPAREN ENTONCES
                    SI profundidad_parentesis <= 0 ENTONCES
                        agregar(errores, ("201", etiqueta_linea + "Unmatched delimiter ')'."))
                        idx ← idx + 1
                        apilar(pila, EXPR_TAIL)
                    FIN SI
                SINO SI actual != NULO ENTONCES
                    SI esInicioFactor(actual) ENTONCES
                        agregar(errores, ("202", etiqueta_linea + "Missing operator before '" + tokens[idx].lexema + "'."))
                        apilar(pila, EXPR_TAIL)
                        apilar(pila, TERM)
                    SINO
                        agregar(errores, ("202", etiqueta_linea + "Missing operator near '" + tokens[idx].lexema + "'."))
                        idx ← idx + 1
                        apilar(pila, EXPR_TAIL)
                    FIN SI
                FIN SI

            CASO TERM:
                desapilar(pila)
                SI actual == NULO ENTONCES
                    agregar(errores, ("203", etiqueta_linea + "Missing identifier/constant."))
                SINO SI esInicioFactor(actual) ENTONCES
                    apilar(pila, TERM_TAIL)
                    apilar(pila, FACTOR)
                SINO SI actual == RPAREN ENTONCES
                    agregar(errores, ("203", etiqueta_linea + "Missing identifier/constant before ')'."))
                SINO
                    agregar(errores, ("203", etiqueta_linea + "Missing identifier/constant near '" + tokens[idx].lexema + "'."))
                    idx ← idx + 1
                    apilar(pila, TERM)
                FIN SI

            CASO TERM_TAIL:
                desapilar(pila)
                SI actual EN {MUL, DIV} ENTONCES
                    apilar(pila, TERM_TAIL)
                    apilar(pila, FACTOR)
                    apilar(pila, SI actual == MUL ENTONCES MUL SINO DIV)
                FIN SI

            CASO FACTOR:
                desapilar(pila)
                SI actual == LPAREN ENTONCES
                    apilar(pila, RPAREN)
                    apilar(pila, EXPR_TAIL)
                    apilar(pila, TERM)
                    apilar(pila, LPAREN)
                SINO SI actual EN {PLUS, MINUS} ENTONCES
                    apilar(pila, FACTOR)
                    apilar(pila, SI actual == PLUS ENTONCES PLUS SINO MINUS)
                SINO SI actual EN {IDENTIFIER, CONSTANT} ENTONCES
                    apilar(pila, OPERAND)
                SINO SI actual == NULO ENTONCES
                    agregar(errores, ("203", etiqueta_linea + "Missing identifier/constant."))
                SINO SI actual == RPAREN ENTONCES
                    agregar(errores, ("203", etiqueta_linea + "Missing identifier/constant before ')'."))
                SINO
                    agregar(errores, ("203", etiqueta_linea + "Missing identifier/constant before '" + tokens[idx].lexema + "'."))
                    idx ← idx + 1
                FIN SI
        FIN SEGÚN
    FIN MIENTRAS

    MIENTRAS NO pila ESTÁ VACÍA HACER
        SI desapilar(pila) == RPAREN ENTONCES
            agregar(errores, ("201", etiqueta_linea + "Missing delimiter ')'."))
        FIN SI
    FIN MIENTRAS

    MIENTRAS idx < n HACER
        extra ← tokens[idx]
        idx ← idx + 1
        SI extra.tipo == RPAREN ENTONCES
            agregar(errores, ("201", etiqueta_linea + "Missing delimiter '(' or extra ')'."))
        SINO SI extra.tipo == LPAREN ENTONCES
            agregar(errores, ("202", etiqueta_linea + "Missing operator before '('."))
        SINO SI extra.tipo EN {IDENTIFIER, CONSTANT} ENTONCES
            agregar(errores, ("202", etiqueta_linea + "Missing operator before '" + extra.lexema + "'."))
        SINO
            agregar(errores, ("203", etiqueta_linea + "Missing identifier/constant near '" + extra.lexema + "'."))
        FIN SI
    FIN MIENTRAS

    RETORNAR errores
FIN FUNCIÓN
